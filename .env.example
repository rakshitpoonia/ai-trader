# Copy to .env and fill in. Only OPENROUTER_API_KEY is required; everything
# else degrades gracefully. See README.md for what each key changes.

# --- Models -------------------------------------------------------------
# The only required key. All four traders share OpenRouter's free-model
# router unless USE_MANY_MODELS=true.
OPENROUTER_API_KEY=

# Set USE_MANY_MODELS=true to give each trader a different frontier model
# called directly on its own provider. Each then needs its own key.
USE_MANY_MODELS=false
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
GOOGLE_API_KEY=

# --- Market data --------------------------------------------------------
# Without this, prices come from the local simulator and the market is
# always considered open.
MASSIVE_API_KEY=

# --- Research -----------------------------------------------------------
# Without this, web search fails and the researcher falls back to fetch.
TAVILY_API_KEY=

# --- Notifications ------------------------------------------------------
PUSHOVER_USER=
PUSHOVER_TOKEN=

# --- Scheduler ----------------------------------------------------------
RUN_EVERY_N_MINUTES=240
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
